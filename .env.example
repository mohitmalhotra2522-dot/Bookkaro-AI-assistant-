# BookKaro AI — server-side configuration (never exposed to the frontend).
#
# Booking execution boundary (Prompt 10).
# Real booking is DISABLED. Only the exact value "true" would enable the flag;
# missing / empty / malformed values are treated as false (fail closed).
# Even if set to true, this build only contains the DisabledBookingExecutor:
# no IRCTC login, form submission, OTP, CAPTCHA, payment or PNR is possible.
REAL_BOOKING_ENABLED=false

# Executor name (only "disabled" exists in this build). Unknown executors fail closed.
BOOKING_EXECUTOR=disabled

# Optional handoff TTL in ms (1 … 900000). Default = availability freshness window (120000).
# BOOKING_HANDOFF_TTL_MS=120000
# Optional BookingHandoffSession lifetime (ms). Capped by the handoff expiry; max 15 min.
# BOOKING_HANDOFF_SESSION_TTL_MS=120000

# ---- Booking provider boundary (Prompt 12) ----
# Provider name. Missing / malformed → "disabled". Only "disabled" exists in this build;
# any other name (e.g. a future official/partner provider) fails closed with
# BOOKING_PROVIDER_UNKNOWN until such an adapter is actually implemented and registered.
# There is NO automatic fallback between providers. Real booking also requires
# REAL_BOOKING_ENABLED=true (master switch above).
BOOKING_PROVIDER=disabled
# Optional base URL for a FUTURE provider adapter (https:// required in production).
# BOOKING_PROVIDER_BASE_URL=
# Provider call timeout in ms (1000 … 60000, default 15000).
# BOOKING_PROVIDER_TIMEOUT_MS=15000
# Deliberately absent: IRCTC_USERNAME / IRCTC_PASSWORD / OTP / CAPTCHA / payment secrets.

# ---- Prompt 13: booking execution lifecycle / status reconciliation (server-side only) ----
# Bounded status checks after an uncertain outcome (timeout / lost connection). Never re-submits.
BOOKING_RECONCILIATION_MAX_ATTEMPTS=3
BOOKING_RECONCILIATION_BACKOFF_MS=1000
BOOKING_RECONCILIATION_TIMEOUT_MS=10000
# Unresolved longer than this → MANUAL_VERIFICATION_REQUIRED (checked lazily, no polling)
BOOKING_EXECUTION_UNRESOLVED_TTL_MS=900000
