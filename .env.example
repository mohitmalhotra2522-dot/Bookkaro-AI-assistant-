# BookKaro AI — server-side configuration (never exposed to the frontend).
#
# Booking execution boundary (Prompt 10).
# Real booking is DISABLED. Only the exact value "true" would enable the flag;
# missing / empty / malformed values are treated as false (fail closed).
# Even if set to true, this build only contains the DisabledBookingExecutor:
# no IRCTC login, form submission, OTP, CAPTCHA, payment or PNR is possible.
REAL_BOOKING_ENABLED=false

# Executor name (only "disabled" exists in this build). Unknown executors fail closed.
BOOKING_EXECUTOR=disabled

# Optional handoff TTL in ms (1 … 900000). Default = availability freshness window (120000).
# BOOKING_HANDOFF_TTL_MS=120000
# Optional BookingHandoffSession lifetime (ms). Capped by the handoff expiry; max 15 min.
# BOOKING_HANDOFF_SESSION_TTL_MS=120000

# ---- Booking provider boundary (Prompt 12) ----
# Provider name. Missing / malformed → "disabled". Only "disabled" exists in this build;
# any other name (e.g. a future official/partner provider) fails closed with
# BOOKING_PROVIDER_UNKNOWN until such an adapter is actually implemented and registered.
# There is NO automatic fallback between providers. Real booking also requires
# REAL_BOOKING_ENABLED=true (master switch above).
BOOKING_PROVIDER=disabled
# Optional base URL for a FUTURE provider adapter (https:// required in production).
# BOOKING_PROVIDER_BASE_URL=
# Provider call timeout in ms (1000 … 60000, default 15000).
# BOOKING_PROVIDER_TIMEOUT_MS=15000
# Deliberately absent: IRCTC_USERNAME / IRCTC_PASSWORD / OTP / CAPTCHA / payment secrets.

# ---- Prompt 13: booking execution lifecycle / status reconciliation (server-side only) ----
# Bounded status checks after an uncertain outcome (timeout / lost connection). Never re-submits.
BOOKING_RECONCILIATION_MAX_ATTEMPTS=3
BOOKING_RECONCILIATION_BACKOFF_MS=1000
BOOKING_RECONCILIATION_TIMEOUT_MS=10000
# Unresolved longer than this → MANUAL_VERIFICATION_REQUIRED (checked lazily, no polling)
BOOKING_EXECUTION_UNRESOLVED_TTL_MS=900000

# ---- Conversational LLM (Prompt 21/23) — server-side only, never sent to the browser ----
# Leave LLM_PROVIDER unset (or "mock") for the offline MockLLM. If set but misconfigured, the agent fails CLOSED
# (safe "unavailable" reply) — it never silently switches to the mock or another model.
# LLM_PROVIDER=openai-compatible
# LLM_API_KEY=your-key-here
# LLM_MODEL=z-ai/glm-5.3-flash
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_TIMEOUT_MS=30000
# Optional explicit fallback model on the same endpoint/key, used only when the primary times out / errors (visible in /api/health + logs):
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# LLM_FALLBACK_TIMEOUT_MS=60000
# LLM_FALLBACK_COOLDOWN_MS=300000
# LLM_TOOL_MODE=native        # native function calling (default) | json (legacy single-JSON decisions)

# ---- Prompt 35: real railway providers (keys server-side only; never commit real values) ----
# RAILWAY_PROVIDER=live                       # default: mock (labelled non-live)
# RAILWAY_PRIMARY_PROVIDER=railcore
# RAILWAY_FALLBACK_PROVIDERS=railkit,railradar
# Optional (2026-10-09): ordered chain for seat availability + fare ONLY (search / route keep the chain above).
# Recommended with a RailKit Advance key: primary railcore, fallback railradar, availability railkit,railcore,railradar
# RAILWAY_AVAILABILITY_PROVIDERS=railkit,railcore,railradar
# RAILCORE_API_KEY=
# RAILKIT_API_KEY=
# RailKit monthly requests — LOCAL estimate only (not authoritative: RailKit sends no quota headers). At the
# effective limit (limit − margin) RailKit is skipped without a request and the next provider answers.
# RAILKIT_MONTHLY_LIMIT=10000
# RAILKIT_MONTHLY_SAFETY_MARGIN=200
# RAILKIT_QUOTA_STATE_FILE=          # optional JSON {month, used}; without it the estimate restarts at 0 on restart
# RAILKIT_MONTHLY_QUOTA=off          # disable the local accounting
# RAILRADAR_API_KEY=
# RAILWAY_PROVIDER_TIMEOUT_MS=4000            # per provider attempt
# RAILWAY_FAILOVER_BUDGET_MS=7500             # whole chain (default min(tool timeout - 1500, 7500))
# RAILCORE_BASE_URL= / RAILKIT_BASE_URL= / RAILRADAR_BASE_URL=   # documented defaults are built in

# ---- Prompt 35: external web research (LLM-chosen tool; never authoritative). Off unless all three are set ----
# WEB_RESEARCH_ENABLED=true
# WEB_RESEARCH_PROVIDER=tavily
# WEB_RESEARCH_API_KEY=

# ---- Prompt 35: server voice (OpenAI-compatible STT/TTS for /api/voice/turn and /api/voice/speak) ----
# VOICE_STT_PROVIDER=openai_compatible
# VOICE_STT_BASE_URL=
# VOICE_STT_MODEL=
# VOICE_STT_API_KEY=
# VOICE_TTS_PROVIDER=openai_compatible
# VOICE_TTS_BASE_URL=
# VOICE_TTS_MODEL=
# VOICE_TTS_VOICE=alloy
# VOICE_TTS_API_KEY=

# ---- P36-C: ElevenLabs Scribe v2 BATCH STT for tap-to-talk (/api/voice/transcribe). SERVER ENV ONLY. ----
# Model (scribe_v2), language (hin) and keyterms (AC,3A,CC,SL,RAC,WL) are locked in server code — not configurable.
# Missing key → STT reported unavailable; the browser speech path stays the fallback. Never prefix with VITE_.
# ELEVENLABS_API_KEY=
# ELEVENLABS_STT_TIMEOUT_MS=8000
# ELEVENLABS_STT_ENABLED=true
